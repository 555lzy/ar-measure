<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <fragment
        android:id="@+id/ar_fragment"
        android:name="com.qh.armeasure.MeasureArFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/crosshair"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/ic_crosshair"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Compact floating readout: the camera remains the main part of the screen. -->
    <TextView
        android:id="@+id/txt_hud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:background="@drawable/bg_hud_card"
        android:gravity="center"
        android:maxLines="2"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp"
        android:textColor="@color/text_primary"
        android:textSize="19sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txt_quality"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="26dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="26dp"
        android:background="@drawable/bg_status_chip"
        android:gravity="center"
        android:maxLines="2"
        android:paddingLeft="12dp"
        android:paddingTop="8dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/txt_hud"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tips appear inside the bottom tray so they do not cover the target or reticle. -->
    <LinearLayout
        android:id="@+id/bottom_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_measure_panel"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txt_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_tip_card"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingTop="8dp"
            android:paddingRight="10dp"
            android:paddingBottom="8dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_place"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:enabled="false"
            android:text="@string/btn_place_first"
            android:textAllCaps="false"
            android:textColor="@color/button_text"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@color/accent"
            app:cornerRadius="17dp"
            app:rippleColor="@color/accent_pressed" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_undo"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:text="@string/btn_undo"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:backgroundTint="@color/button_secondary"
                app:cornerRadius="14dp"
                app:strokeColor="@color/button_stroke"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_unit"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginLeft="6dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:text="@string/btn_unit"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:backgroundTint="@color/button_secondary"
                app:cornerRadius="14dp"
                app:strokeColor="@color/button_stroke"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginLeft="6dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:text="@string/mode_precision_short"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:backgroundTint="@color/button_secondary"
                app:cornerRadius="14dp"
                app:strokeColor="@color/button_stroke"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginLeft="6dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:text="@string/btn_clear"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:backgroundTint="@color/button_secondary"
                app:cornerRadius="14dp"
                app:strokeColor="@color/button_stroke"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
